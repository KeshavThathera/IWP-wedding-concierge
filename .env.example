# Copy to .env (never commit .env). Everything is optional for local development.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# DATABASE_URL=postgres://user:password@host:5432/iwp   # defaults to SQLite (db.sqlite3)

# Gemini (free tier key from https://aistudio.google.com/apikey). Leave empty for rules-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=minimal     # keeps replies fast and complete
# GEMINI_TIMEOUT=6                 # seconds per model before failing over
# GEMINI_MAX_RPM=12                 # global requests/minute cap, keeps you inside free-tier limits
# GEMINI_MAX_PER_VISITOR_HOUR=30
